":"196px","top":"1351px","left":"-1px","box-sizing":"content-box","height":"57px","position":"absolute","border-radius":"10px 10px 10px 10px ","border-width":"1px 1px 1px 1px ","border-style":"solid","border-color":"rgba(206,133,71,1)"},"mobile":{}},"data":{"component":null},"innerHtml":"<a href=\"#!page-home\" class=\"\">\n                        </a><p><a href=\"#!page-home\" class=\"\">More Works<br></a></p>","tagName":"DIV"},{"id":"silex-id-1736777857035-0","tagName":"DIV","type":"image-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"144px","height":"146px","position":"absolute","top":"499px","left":"410px"}},"data":{"component":null},"children":[],"pageNames":["page-home"],"classList":[],"attr":{},"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":false,"innerHtml":"<img src=\"/ce/github/get/Portfolio/gh-pages/assets/1707152852985.jpeg\" />"},{"id":"silex-id-1736778025440-1","tagName":"DIV","type":"text-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"904px","height":"361px","position":"absolute","top":"96px","left":"34px"}},"data":{"component":null},"children":[],"pageNames":["page-home"],"classList":[],"attr":{},"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"<p></p><p>Ayant toujours souhaité travailler dans le monde médiatique, principalement en lien avec la musique, intégrer l’Institut Français de Presse fut une occasion de poursuivre, en me formant, mon exploration de cet univers qui me plaît tant.</p><p>Intégrer le Master “Médias et mondialisation”, en Information-Communication, fut utile pour acquérir des compétences dans les champs journalistiques et de la communication ou encore pour continuer à développer, de ma propre initiative, mes capacités de rédaction et de montage en tous genres.</p><p>Au cours de cette première année, riche en enseignements, j’ai pu mener de multiples projets, avec une liberté tant au niveau du format que de la thématique traitée. J’ai donc, à diverses reprises, saisi ces opportunités pour traiter des thèmes correspondant à mes centres d’intérêt, via des formats auxquels je souhaitais m’initier ou dont la maîtrise totale me faisait encore défaut.</p><p>J’ai ainsi pu enregistrer plusieurs podcasts, réaliser et monter un reportage, rédiger des articles, faire de la veille informationnelle et autres, tout en plaçant toujours la musique et la culture au centre de mes travaux.</p><br><p></p>"},{"id":"silex-id-1736778863824-2","tagName":"DIV","type":"text-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"905px","height":"381px","position":"absolute","top":"89.25px","left":"34px","background-color":"rgba(255,255,255,1)"}},"data":{"component":null},"children":[],"pageNames":["page-home"],"classList":[],"attr":{},"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"<p></p><p>Rap FR Tendance est un média dédié au Rap Français, présent sur les réseaux sociaux, que j’ai intégré en octobre 2023.</p><p>Actif principalement sur Instagram (49 300 abonnés), mais aussi sur TikTok (14 600 abonnés) ou encore sur Linkedin, Rap FR Tendance est composé d’une équipe de 4 personnes. Le média dispose d’une ligne éditoriale définie, basée autour de styles musicaux et d’artistes spécifiques, qui vise à s’étendre à d’autres thématiques ; cinéma, mode, RnB, musique internationale et plus encore.</p><p>Mon engagement au sein de Rap FR Tendance implique de multiples aspects : création de contenus photo et vidéo, rédaction d’articles ainsi que de “wordings”, veille sur l’actualité, couverture médiatique d’évènements professionnels et musicaux, recherche de nouveaux concepts originaux, interviews d’artistes, montage photo et vidéo, etc.</p><p>Rap FR Tendance est une grande aventure qui me permet de développer mes compétences, de prendre connaissance du milieu professionnel de la musique, de développer ma créativité et surtout de nourrir mes passions et mes rêves.</p><br><p></p>"},{"id":"silex-id-1736780475263-4","pageNames":["page-home"],"classList":["style-button-text-box"],"type":"text-element","isSectionContent":false,"title":"","alt":null,"children":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"visibility":{"desktop":true,"mobile":true},"style":{"desktop":{"width":"196px","top":"439.75px","left":"743px","box-sizing":"content-box","height":"57px","position":"absolute","border-radius":"10px 10px 10px 10px ","border-width":"1px 1px 1px 1px ","border-style":"solid","border-color":"rgba(255,255,255,1)"},"mobile":{}},"data":{"component":null},"innerHtml":"<a href=\"#!page-home\">\n                        </a><p><a href=\"https://www.instagram.com/rapfrtendance/\" title=\"Rap FR Tendance - Instagram\" linktype=\"LinkTypeExternal\">Learn More</a></p>","tagName":"DIV"},{"id":"silex-id-1736781283217-6","tagName":"DIV","type":"image-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"328px","height":"345px","position":"absolute","top":"557px","left":"105px"}},"data":{"component":null},"children":[],"pageNames":["page-home"],"classList":[],"attr":{},"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":false,"inn